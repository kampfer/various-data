# 复制为 .env 后按机器修改；.env 不入库
# 运行环境：pro 使用 data/various_data.db，其余使用 data/various_data_dev.db
mode=pro

# Python 解释器：生产用虚拟环境的绝对路径，开发可写 pipenv 环境的 python 路径
PYTHON_BIN=/opt/various-data/.venv/bin/python

# 本目录的绝对路径（DAG 用它拼接 tasks/ 下的脚本）
DAGU_DIR=/opt/various-data/src/dagu

# 任务失败告警的收发地址
ALERT_EMAIL=you@example.com

# SMTP 凭据，仅被 ~/.config/dagu/base.yaml 引用，不进入仓库
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
