{
  // 使用 IntelliSense 了解相关属性。 
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",    // 指向项目根目录
      "args": [
          "main:app",                             // 模块名:实例名
          "--app-dir", "./src/web/backEnd",      // 关键！与命令行一致
          "--reload",                             // 热重载
          "--port", "8000"
      ],
      "env": {
          "PYTHONPATH": "${workspaceFolder}"     // 确保根目录在Python路径中
      },
      "console": "integratedTerminal"
    },
    {
      "name": "pro",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "env": {
        "mode": "pro"
      }
    }
  ]
}